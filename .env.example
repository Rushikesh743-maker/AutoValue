# AutoValue Environment Configuration Example
# Copy this template to .env and configure values for your deployment target.
# NEVER commit production secrets, database credentials, or private keys.

# ==============================================================================
# 1. Application & Environment Mode
# ==============================================================================
PROJECT_NAME="AutoValue API"
VERSION="0.9.0"
API_V1_STR="/api"
ENVIRONMENT="development"       # Options: development, staging, production, testing
DEBUG=true                      # Set to false in production (enforced automatically)
DOCS_ENABLED=true               # Enable Swagger UI at /api/docs and OpenAPI spec

# ==============================================================================
# 2. Host & Base URLs
# ==============================================================================
API_BASE_URL="http://localhost:8000"
FRONTEND_BASE_URL="http://localhost:5173"
# Comma-separated or JSON list of allowed Host header domains in production
TRUSTED_HOSTS=["localhost","127.0.0.1","autovalue.internal"]

# ==============================================================================
# 3. Authentication & Security Secrets (MANDATORY in Production)
# ==============================================================================
# In production, generate strong 256-bit random secrets (e.g. `openssl rand -hex 32`)
SECRET_KEY="generate-a-strong-random-secret-key-for-production"
AUTH_SECRET="generate-a-strong-random-auth-secret-for-jwt-signing"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false             # MUST be set to true in production with HTTPS
COOKIE_SAMESITE="lax"           # Options: lax, strict, none
COOKIE_NAME="autovalue_token"

# ==============================================================================
# 4. Database Connection & Connection Pooling
# ==============================================================================
# PostgreSQL production format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/autovalue"
DB_POOL_SIZE=10                 # Number of persistent database connections
DB_MAX_OVERFLOW=20              # Max burst connections beyond pool size
DB_POOL_TIMEOUT=30              # Seconds to wait before timing out on pool checkout
DB_POOL_RECYCLE=1800            # Seconds before automatically recycling connections (30 min)

# ==============================================================================
# 5. Machine Learning Model & Artifact Paths
# ==============================================================================
RAW_DATA_DIR="data/raw"
PROCESSED_DATA_DIR="data/processed"
SAMPLE_DATA_DIR="data/sample"
MODELS_DIR="models"
AUTOVALUE_MODEL_VERSION="v002"

# ==============================================================================
# 6. CORS & Rate Limiting
# ==============================================================================
# Specific allowed origins in production (wildcard '*' is forbidden in production)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576  # 1MB max request size

# ==============================================================================
# 7. Observability & Logging
# ==============================================================================
LOG_LEVEL="INFO"                # Options: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT="json"               # Options: json, text
ENABLE_PROMETHEUS_METRICS=true  # Expose /metrics endpoint for Prometheus scraping

# ==============================================================================
# 8. Collection Pipeline Settings
# ==============================================================================
COLLECTION_ENABLED=false
MAX_RECORDS_PER_SOURCE=50
REQUEST_TIMEOUT_SECONDS=10
REQUEST_DELAY_SECONDS=2.0
USER_AGENT="AutoValue/0.9 (+https://github.com/autovalue; empirical-car-valuation)"
